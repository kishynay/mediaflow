# Mediaflow Environment Configuration
# Copy this file to .env and fill in your values

# Authentication
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# Server Port (for local development)
PORT=3000

# MongoDB Atlas Connection String
# IMPORTANT: use the same MONGODB_URI in local and production if both should see the same uploads.
# Keep the database name in the URI aligned with MONGODB_DB_NAME below.
# Get this from your MongoDB Atlas dashboard.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mediaflow?retryWrites=true&w=majority

# Optional explicit database name override.
# Recommended: set this to the same database name embedded in MONGODB_URI, or leave it blank.
# Example shown for clarity and consistency across local + Render deployments.
MONGODB_DB_NAME=mediaflow

# GridFS bucket name used for uploads/files metadata collections.
# Recommended: keep this identical across local and production.
GRIDFS_BUCKET=uploads

# Optional upload size limit in bytes (default is 500MB if unset)
MAX_FILE_SIZE_BYTES=524288000

# Optional comma-separated extra CORS origins
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# Serve bundled frontend from backend process (set false when frontend is deployed separately)
SERVE_FRONTEND=true

# Enable or disable HTTP Basic Auth for endpoints (false for open access)
# Set to false for public Vercel deployment without auth.
AUTH_ENABLED=true

# Optional: External media directory (if needed)
# EXTERNAL_MEDIA_DIR=