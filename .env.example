# Mediaflow Environment Configuration
# Copy this file to .env and fill in your values

# Authentication
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# Server Port (for local development)
PORT=3000

# MongoDB Atlas Connection String
# Get this from your MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mediaflow?retryWrites=true&w=majority

# Optional: External media directory (if needed)
# EXTERNAL_MEDIA_DIR=